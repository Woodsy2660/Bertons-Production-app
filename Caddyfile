# Caddy reverse proxy for Berton Bottling App
# Uses internal CA (self-signed) for HTTPS - required for camera/barcode scanning
# The root CA must be installed and trusted on each tablet (see deployment docs)

https://10.0.0.4 {
    # Caddy's internal CA issues a self-signed cert with proper IP SAN
    tls internal

    # Proxy to the FastAPI app
    reverse_proxy web:8000

    # Logging
    log {
        output stdout
        format console
    }
}

# Redirect HTTP to HTTPS
http://10.0.0.4 {
    redir https://10.0.0.4{uri} permanent
}
