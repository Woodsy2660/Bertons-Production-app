# Database (local Docker — optional if using Supabase instead)
# DATABASE_URL=postgresql+asyncpg://berton:berton_dev@localhost:5433/berton_bottling

# Database (Supabase — use for local dev AND Vercel production, same project)
# Supabase → Project Settings → Database → Connection string → URI
# Use "Session" or "Direct" (port 5432) for local dev and migrations.
# Use "Transaction" pooler (port 6543) on Vercel serverless (recommended).
# Replace [YOUR-PASSWORD] with the database password from Supabase dashboard.
# URL-encode special characters in the password (@ → %40, etc.)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Other hosted Postgres (Neon, Vercel Postgres) also work — postgres:// is auto-converted.

# App
DEBUG=true
SECRET_KEY=change-this-in-production

# File storage (local)
UPLOAD_DIR=./uploads
COMPILED_OUTPUT_DIR=./compiled_output
STORAGE_BACKEND=local

# File storage (Vercel — create a Blob store and connect it to the project)
# STORAGE_BACKEND=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...   # set automatically when Blob store is connected
# BLOB_ACCESS=private

# Shared logins (two roles only — not per-person accounts)
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator

# Operator run list: today's runs + recently completed
OPERATOR_COMPLETED_RUN_DAYS=7
OPERATOR_COMPLETED_RUN_LIMIT=10

# Dev/QA tools (manager login + this flag; not for production floor)
ENABLE_DEV_TOOLS=false

# Pallet tag printing (browser dispatch until network printer is confirmed)
PALLET_TAGS_PER_SHEET=1
PALLET_TAG_DISPATCH=browser