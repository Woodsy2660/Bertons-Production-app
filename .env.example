# =============================================================================
# Berton Bottling App - Environment Configuration
# =============================================================================
# Copy this to .env and adjust values for your environment.
# WARNING: Change all passwords before handling real/production data!

# -----------------------------------------------------------------------------
# Database (Postgres) - Docker Compose Setup
# -----------------------------------------------------------------------------
# These credentials are used by BOTH the db container and the web container.
# docker-compose.yml automatically constructs DATABASE_URL for internal networking.
POSTGRES_USER=berton
POSTGRES_PASSWORD=berton_dev
POSTGRES_DB=berton_bottling

# For local development OUTSIDE Docker (connects to published port 5433):
# DATABASE_URL=postgresql+asyncpg://berton:berton_dev@localhost:5433/berton_bottling

# -----------------------------------------------------------------------------
# Database (Supabase/Cloud) - Alternative to Docker Postgres
# -----------------------------------------------------------------------------
# For Supabase: Project Settings → Database → Connection string → URI
# Use "Session" or "Direct" (port 5432) for local dev and migrations.
# Use "Transaction" pooler (port 6543) on Vercel serverless (recommended).
# Replace [YOUR-PASSWORD] with the database password. URL-encode special chars.
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# App Settings
# -----------------------------------------------------------------------------
DEBUG=true
SECRET_KEY=change-this-in-production
SESSION_HTTPS_ONLY=false

# Timezone (for container)
TZ=Australia/Sydney

# -----------------------------------------------------------------------------
# File Storage (local)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
COMPILED_OUTPUT_DIR=./compiled_output
STORAGE_BACKEND=local

# -----------------------------------------------------------------------------
# File Storage (Vercel Blob) - for serverless deployment
# -----------------------------------------------------------------------------
# STORAGE_BACKEND=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_STORE_ID=store_...
# BLOB_ACCESS=private

# -----------------------------------------------------------------------------
# Shared Logins (two roles only - not per-person accounts)
# -----------------------------------------------------------------------------
# WARNING: Change these before production use!
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator

# -----------------------------------------------------------------------------
# Operator Dashboard Settings
# -----------------------------------------------------------------------------
OPERATOR_COMPLETED_RUN_DAYS=7
OPERATOR_COMPLETED_RUN_LIMIT=10

# -----------------------------------------------------------------------------
# Dev/QA Tools
# -----------------------------------------------------------------------------
# Only accessible to manager role when enabled; disable for production floor
ENABLE_DEV_TOOLS=false

# -----------------------------------------------------------------------------
# Pallet Tag Printing
# -----------------------------------------------------------------------------
PALLET_TAGS_PER_SHEET=1
PALLET_TAG_DISPATCH=browser
