# =============================================================================
# Local development (app on host, Postgres in Docker)
# =============================================================================
# Start DB:  docker compose up -d db
# App:       python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --reload
#
DATABASE_URL=postgresql+asyncpg://berton:berton_dev@localhost:5433/berton_bottling

DEBUG=true
SECRET_KEY=change-this-in-production

# File storage (local)
UPLOAD_DIR=./uploads
COMPILED_OUTPUT_DIR=./compiled_output
STORAGE_BACKEND=local

# Shared logins (two roles only — not per-person accounts)
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manager
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator

# Operator run list: today's runs + recently completed
OPERATOR_COMPLETED_RUN_DAYS=7
OPERATOR_COMPLETED_RUN_LIMIT=10

# Dev/QA tools (manager login + this flag; not for production floor)
ENABLE_DEV_TOOLS=false

# Pallet tag printing (browser until PrintLAN is routed)
PALLET_TAGS_PER_SHEET=1
PALLET_TAG_DISPATCH=browser

# Session cookie Secure flag:
#   unset / false → cookies work over HTTP (required for LAN tablets)
#   true          → HTTPS only (use when TLS terminates in front of the app)
# Default when unset: true only on Vercel; false elsewhere.
# SESSION_HTTPS_ONLY=false

# =============================================================================
# Production — Azure Docker VM (BV-AZ-DockerHost01 / LAN tablets)
# =============================================================================
# Project path MUST be under /home/azureuser/ (snap Docker).
# Tablets: http://10.0.0.4:8000  (BV-Infra Wi-Fi)
#
# Copy this file to .env on the host, then set:
#
# DEBUG=false
# SECRET_KEY=<openssl rand -hex 32>
# SESSION_HTTPS_ONLY=false
# MANAGER_PASSWORD=<strong>
# OPERATOR_PASSWORD=<strong>
# ENABLE_DEV_TOOLS=false
# STORAGE_BACKEND=local
# # DATABASE_URL is set by compose for the web service (host=db).
# POSTGRES_USER=berton
# POSTGRES_PASSWORD=<strong db password>
# POSTGRES_DB=berton_bottling
# # Do not publish Postgres to the LAN in prod if avoidable:
# # POSTGRES_PUBLISH_PORT=127.0.0.1:5432
# APP_PORT=8000
# APP_VERSION=0.1.0
#
# Start full stack:
#   docker compose --profile full up -d --build
#   # or: ./scripts/deploy.sh

# =============================================================================
# Optional: Supabase / Vercel (secondary demo host — not the winery floor)
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@...pooler.supabase.com:5432/postgres?sslmode=require
# STORAGE_BACKEND=blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_ACCESS=private
